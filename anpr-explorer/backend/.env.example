PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me-long-random
APP_ENCRYPTION_KEY=base64-32-bytes-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=argon2id-hash-here
CORS_ORIGIN=http://localhost:5173
DB_PATH=./data/anpr-explorer.db

# --- Note operative ---
# APP_ENCRYPTION_KEY: chiave di cifratura (KEK) dei segreti PDND nel DB.
#   Genera con: openssl rand -base64 32
#
# ADMIN_PASSWORD_HASH: hash argon2id della password dell'amministratore.
#   Genera con: node -e "require('argon2').hash('LaTuaPassword').then(console.log)"
#
# SESSION_SECRET: stringa casuale lunga almeno 32 caratteri.
#   Genera con: openssl rand -base64 48
#
# I valori PDND (client_id, kid, chiave privata, purposeId, endpoint) si inseriscono
# via UI in Impostazioni e vengono salvati CIFRATI nel DB: non vanno mai messi qui.
#
# Per l'ambiente di Collaudo, il token endpoint PDND è tipicamente su
# auth.uat.interop.pagopa.it; per Produzione su auth.interop.pagopa.it.
# VERIFICARE i valori esatti nel back-office PDND (cambiano nel tempo).
